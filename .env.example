# Wavecrest Strategies Environment Variables

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.wavecreststrategies.ca

# Email Configuration (for contact form)
# Using Resend or your preferred email service
RESEND_API_KEY=your_resend_api_key_here

# Optional: Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Optional: TidyCal Calendar Integration
# The TidyCal script is embedded directly; no API key needed if using the embed code
NEXT_PUBLIC_TIDYCAL_URL=https://tidycal.com/wavecreststrategies
